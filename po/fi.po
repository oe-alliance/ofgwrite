msgid "Writing and verifying Dream kernel A"
msgstr "Kirjoitetaan ja tarkistetaan Dream-kernel A"

msgid "Flashing failed"
msgstr "Flashaus epäonnistui"

msgid "Done"
msgstr "Valmis"

#, c-format
msgid "Step %d of %d"
msgstr "Vaihe %d / %d"

msgid "Check only, nothing is written"
msgstr "Vain tarkistus, mitään ei kirjoiteta"

msgid "Do not switch off the receiver"
msgstr "Älä sammuta vastaanotinta"

#, c-format
msgid "Restart in %d s"
msgstr "Uudelleenkäynnistys %d s kuluttua"

#, c-format
msgid "Ends in %d s"
msgstr "Päättyy %d s kuluttua"

msgid "Writing ext4 kernel"
msgstr "Kirjoitetaan ext4-kerneliä"

msgid "Deleting rootfs"
msgstr "Poistetaan rootfs"

msgid "Extracting rootfs"
msgstr "Puretaan rootfs"

msgid "Erasing kernel"
msgstr "Tyhjennetään kernel"

msgid "Writing kernel"
msgstr "Kirjoitetaan kernel"

msgid "Copying rootfs"
msgstr "Kopioidaan rootfs"

msgid "Erasing rootfs"
msgstr "Tyhjennetään rootfs"

msgid "Writing rootfs"
msgstr "Kirjoitetaan rootfs"

msgid "Enigma2 could not be stopped, switching to runlevel 2 failed."
msgstr "Enigma2:n pysäyttäminen epäonnistui, siirtyminen ajotasolle 2 epäonnistui."

msgid "Nothing was flashed."
msgstr "Mitään ei flashattu."

msgid "Wait until E2 is stopped"
msgstr "Odota, kunnes E2 on pysäytetty"

msgid "Enigma2 could not be stopped."
msgstr "Enigma2:n pysäyttäminen epäonnistui."

msgid "Enigma2 starts again, nothing was flashed."
msgstr "Enigma2 käynnistyy uudelleen, mitään ei flashattu."

msgid "The flash environment could not be prepared."
msgstr "Flashausympäristön valmistelu epäonnistui."

msgid "The mounts could not be moved to the flash environment."
msgstr "Liitospisteitä ei voitu siirtää flashausympäristöön."

msgid "The root file system could not be mounted again."
msgstr "Root-tiedostojärjestelmää ei voitu liittää uudelleen."

msgid "The root file system could not be mounted read-only."
msgstr "Root-tiedostojärjestelmää ei voitu liittää vain luku -tilaan."

msgid "The rootfs could not be unpacked. The flashed image will not start like this."
msgstr "rootfs:n purkaminen epäonnistui. Flashattu image ei käynnisty tässä tilassa."

msgid "Flash a backup."
msgstr "Palauta varmuuskopio."

msgid "The check was successful."
msgstr "Tarkistus onnistui."

msgid "The kernel was flashed."
msgstr "Kernel flashattiin."

msgid "The kernel could not be flashed. The flashed image will not start like this."
msgstr "Kernelin flashaus epäonnistui. Flashattu image ei käynnisty tässä tilassa."

msgid "Killing processes"
msgstr "Pysäytetään prosesseja"

msgid "Syncing filesystem"
msgstr "Synkronoidaan tiedostojärjestelmä"

msgid "init 2"
msgstr "init 2"

msgid "Mount rootfs"
msgstr "Liitä rootfs"

msgid "The root file system could not be mounted."
msgstr "Root-tiedostojärjestelmää ei voitu liittää."

msgid "The rootfs could not be flashed. The flashed image will not start like this."
msgstr "rootfs:n flashaus epäonnistui. Flashattu image ei käynnisty tässä tilassa."

msgid "Create Kernel.img"
msgstr "Luodaan Kernel.img"

msgid "The image was flashed."
msgstr "Image flashattiin."

#, c-format
msgid "Bad blocks: %d (uncritical, when no changes)"
msgstr "Viallisia lohkoja: %d (ei kriittistä, jos muutoksia ei ole)"

msgid "Flashing UBI image"
msgstr "Flashataan UBI-imagea"

msgid "Formatting remaining eraseblocks"
msgstr "Alustetaan jäljellä olevat tyhjennyslohkot"
