msgid "Writing and verifying Dream kernel A"
msgstr "Escribiendo y verificando el kernel Dream A"

msgid "Flashing failed"
msgstr "Error al flashear"

msgid "Done"
msgstr "Hecho"

#, c-format
msgid "Step %d of %d"
msgstr "Paso %d de %d"

msgid "Check only, nothing is written"
msgstr "Solo comprobación, no se escribe nada"

msgid "Do not switch off the receiver"
msgstr "No apague el receptor"

#, c-format
msgid "Restart in %d s"
msgstr "Reinicio en %d s"

#, c-format
msgid "Ends in %d s"
msgstr "Finaliza en %d s"

msgid "Writing ext4 kernel"
msgstr "Escribiendo kernel ext4"

msgid "Deleting rootfs"
msgstr "Borrando rootfs"

msgid "Extracting rootfs"
msgstr "Extrayendo rootfs"

msgid "Erasing kernel"
msgstr "Borrando kernel"

msgid "Writing kernel"
msgstr "Escribiendo kernel"

msgid "Copying rootfs"
msgstr "Copiando rootfs"

msgid "Erasing rootfs"
msgstr "Borrando rootfs"

msgid "Writing rootfs"
msgstr "Escribiendo rootfs"

msgid "Enigma2 could not be stopped, switching to runlevel 2 failed."
msgstr "No se pudo detener Enigma2: el cambio al runlevel 2 ha fallado."

msgid "Nothing was flashed."
msgstr "No se ha flasheado nada."

msgid "Wait until E2 is stopped"
msgstr "Espere a que Enigma2 se detenga"

msgid "Enigma2 could not be stopped."
msgstr "No se pudo detener Enigma2."

msgid "Enigma2 starts again, nothing was flashed."
msgstr "Enigma2 se inicia de nuevo; no se ha flasheado nada."

msgid "The flash environment could not be prepared."
msgstr "No se pudo preparar el entorno de flasheo."

msgid "The mounts could not be moved to the flash environment."
msgstr "No se pudieron mover los puntos de montaje al entorno de flasheo."

msgid "The root file system could not be mounted again."
msgstr "No se pudo volver a montar el sistema de archivos raíz."

msgid "The root file system could not be mounted read-only."
msgstr "No se pudo montar el sistema de archivos raíz en modo solo lectura."

msgid "The rootfs could not be unpacked. The flashed image will not start like this."
msgstr "No se pudo extraer el rootfs. La imagen flasheada no arrancará así."

msgid "Flash a backup."
msgstr "Flashee una copia de seguridad."

msgid "The check was successful."
msgstr "La comprobación se ha realizado correctamente."

msgid "The kernel was flashed."
msgstr "El kernel se ha flasheado."

msgid "The kernel could not be flashed. The flashed image will not start like this."
msgstr "No se pudo flashear el kernel. La imagen flasheada no arrancará así."

msgid "Killing processes"
msgstr "Finalizando procesos"

msgid "Syncing filesystem"
msgstr "Sincronizando sistema de archivos"

msgid "init 2"
msgstr "Deteniendo Enigma2 y servicios"

msgid "Mount rootfs"
msgstr "Montar rootfs"

msgid "The root file system could not be mounted."
msgstr "No se pudo montar el sistema de archivos raíz."

msgid "The rootfs could not be flashed. The flashed image will not start like this."
msgstr "No se pudo flashear el rootfs. La imagen flasheada no arrancará así."

msgid "Create Kernel.img"
msgstr "Crear kernel.img"

msgid "The image was flashed."
msgstr "La imagen se ha flasheado."

#, c-format
msgid "Bad blocks: %d (uncritical, when no changes)"
msgstr "Bloques defectuosos: %d (no crítico, mientras no aumenten)"

msgid "Flashing UBI image"
msgstr "Flasheando imagen UBI"

msgid "Formatting remaining eraseblocks"
msgstr "Formateando bloques de borrado restantes"
